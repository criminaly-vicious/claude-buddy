{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Read(./src/**)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "env": {
    "EXAMPLE_FLAG": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  }
}
